# ReadPort configuration
# Precedence: environment variables > in-app admin settings (stored in the database) > defaults.
# Any RP_* variable also accepts a RP_*_FILE variant pointing at a file containing the value
# (recommended for secrets, e.g. Docker secrets).

# --- Host paths and ports (read by docker-compose.yml, not by the server) ---
# Where your real libraries live ON THE HOST. The stock compose file mounts
# these at /library/ebooks, /library/audiobooks and /library/alignments, so
# this is the only place you have to change to point ReadPort at your books -
# the compose file itself never needs editing. Defaults are the sample
# library committed in this repo.
RP_EBOOK_PATH=./fixtures/library/ebooks
RP_AUDIOBOOK_PATH=./fixtures/library/audiobooks
# Writable, and the one library folder ReadPort creates files in. If you point
# it at a new folder, chown it to PUID:PGID on the host first.
RP_ALIGNMENT_PATH=./alignments
# Host port published for the web UI. The container always listens on 8383.
RP_HTTP_PORT=8383

# --- Core ---
# Port the web/API server listens on. Under the stock docker-compose.yml the
# container port is fixed at 8383 and this is ignored - change RP_HTTP_PORT
# above instead. Applies to bare-metal runs and to a compose file you edit.
RP_PORT=8383
# Bind address inside the container/host. Default 127.0.0.1; the image sets
# 0.0.0.0 so the port is reachable from outside the container.
RP_HOST=0.0.0.0
# Writable state directory (SQLite database, derived indexes, progress). Local disk only - never SMB/NFS.
RP_DATA_DIR=/data
# Writable cache directory (covers, alignment work). Safe to delete; will be rebuilt.
RP_CACHE_DIR=/cache
# Where the alignment model is kept (one 317 MB download, all languages).
RP_MODELS_DIR=/models

# --- Libraries (read-only mounts) ---
# Comma-separated list of ebook root directories.
RP_EBOOK_DIRS=/library/ebooks
# Comma-separated list of audiobook root directories.
RP_AUDIOBOOK_DIRS=/library/audiobooks

# --- Security ---
# Secret used to sign/derive session material. REQUIRED in production.
# Generate one: openssl rand -hex 32
# Prefer RP_SESSION_SECRET_FILE=/run/secrets/rp_session_secret with Docker secrets.
RP_SESSION_SECRET=
# Optional lock on first-run setup. Leave it empty and you simply open the
# app and create your admin account; the window closes for good once that
# account exists. Set it if the server will be reachable from somewhere
# hostile before you have finished setting it up, and the wizard will ask
# for it. Never generated - empty means open.
# Generate one: openssl rand -hex 16   (RP_SETUP_TOKEN_FILE also works.)
RP_SETUP_TOKEN=
# Reverse-proxy trust for client IPs (rate limiting). Default 0: forwarded
# headers are ignored. Set 1 to trust local/private-network proxies, or a
# comma-separated list of proxy IPs/CIDRs to trust exactly those.
RP_TRUST_PROXY=0
# Behind a TUNNEL (Cloudflare, ngrok), the hop RP_TRUST_PROXY can see is not
# the client, so every request from the internet lands in one rate-limit
# bucket - and a stranger can spend your login attempts. Name the header that
# carries the real address and the peers allowed to set it. Rate-limit keys
# only: never an identity, never an authorization input.
RP_CLIENT_IP_HEADER=
RP_CLIENT_IP_SOURCES=
# Set to "1" only when ReadPort is served over HTTPS (enables the Secure cookie flag).
# PWA installation and service workers require HTTPS (or localhost).
RP_TRUST_HTTPS=0
# Session lifetime in days.
RP_SESSION_DAYS=30

# --- Worker / jobs ---
# Run background jobs inside the web process (1) or rely on a separate worker container (0).
RP_INLINE_WORKER=1
# How many books may be aligned at the same time. Scans, indexing, pairing and
# the model download have lanes of their own and are not counted here.
RP_JOB_CONCURRENCY=2

# --- Reverse-proxy single sign-on (optional; see docs/security.md) ---
# Header set by Authentik/Authelia/oauth2-proxy after login. Empty = disabled.
RP_PROXY_AUTH_HEADER=
# Proxy IPs/CIDRs whose header is trusted (checked on the TCP peer, so a LAN
# client hitting the port directly can never forge it). Required when enabled.
RP_PROXY_AUTH_SOURCES=
# Usernames (as the proxy sends them) that are admins. On a fresh instance the
# first proxied user becomes admin anyway.
RP_PROXY_AUTH_ADMINS=

# --- Alignment ---
# Where computed alignments are saved as files, one per aligned pair. This is
# the only library folder ReadPort writes into, so mount it read-write. Keep it
# across rebuilds and a from-scratch redeploy adopts everything back before it
# aligns anything. Set here, the folder is pinned and the wizard/Settings show
# it rather than asking; leave it unset to choose it in the app. Unset =
# <data>/alignments, inside the data volume - it survives container
# replacement and image upgrades, and is lost only with the volume.
# NOTE: the stock docker-compose.yml hard-codes this (and RP_DATA_DIR,
# RP_CACHE_DIR, RP_MODELS_DIR) rather than reading them from here; these four
# lines apply to bare-metal runs and to a compose file you edit yourself.
RP_ALIGNMENT_DIRS=/library/alignments
# Language assumed when a book's own metadata says nothing and its text is not
# enough to tell (BCP-47), e.g. en, he.
RP_DEFAULT_LANGUAGE=en
# Threads the alignment model may use. Should track the container's CPU
# allowance, not the host's core count.
RP_ALIGN_THREADS=4

# --- Library refresh ---
# Minutes between automatic rescans (new titles in Calibre/Audiobookshelf
# folders appear without a manual click). 0 disables.
RP_SCAN_INTERVAL_MINUTES=60

# --- Container runtime (entrypoint) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Misc ---
# Log level: fatal|error|warn|info|debug|trace
RP_LOG_LEVEL=info
# Escape hatch: an extra directory to resolve onnxruntime-node from when the
# native runtime is installed outside the app tree. Unset in every supported
# deployment - the image installs it where a plain import finds it.
#RP_ORT_DIR=
